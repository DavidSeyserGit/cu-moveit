// Plan once from the measured state to `goal`, time the path, follow it, and
// close the loop through the MuJoCo sidecar. Every node except the test
// observer is a library component; the robot is the igus ReBeL preset.
(
    runtime: (rate_target_hz: 50),
    logging: (slab_size_mib: 16, keyframe_interval: 100),
    resources: [
        (id: "planner_rng", provider: "cu_rng::CuRngBundle", config: {"seed": 42}),
    ],
    tasks: [
        (
            id: "goal",
            type: "repose_motion_planning::CuJointGoalTask<6>",
            config: {"goal": [
                {"revolute": 0.4}, {"revolute": -0.3}, {"revolute": 0.5},
                {"revolute": 0.0}, {"revolute": 0.4}, {"revolute": 0.0},
            ]},
        ),
        (
            id: "planner",
            type: "repose_joint_rrt_star::CuJointRrtStarTask<6>",
            background: true,
            anytime: (time_budget_ms: 250.0, quality_target: 0.95),
            resources: {"rng": "planner_rng.rng"},
            config: {"chain": "igus_rebel", "collision_model": "igus_rebel", "base_budget": 256, "refine_budget": 64},
        ),
        (
            id: "timing",
            type: "repose_motion_planning::CuPlanToTrajectoryTask<6, 1024>",
            config: {
                "profile": "cubic",
                "sample_period": 0.02,
                "limits": {
                    "max_velocities": [
                        {"revolute": 0.8}, {"revolute": 0.8}, {"revolute": 0.8},
                        {"revolute": 0.8}, {"revolute": 0.8}, {"revolute": 0.8},
                    ],
                    "max_accelerations": [
                        {"revolute": 2.0}, {"revolute": 2.0}, {"revolute": 2.0},
                        {"revolute": 2.0}, {"revolute": 2.0}, {"revolute": 2.0},
                    ],
                },
            },
        ),
        (id: "follower", type: "repose_trajectory::CuFollowTrajectoryTask<6, 1024>"),
        (
            id: "controller",
            type: "repose_controller::CuControllerTask<6>",
            config: {
                "tracking_error_limit": 0.5,
                "state_timeout": 0.2,
                "rate_limit": {"max_speed": 1.5, "max_acceleration": 6.0},
            },
        ),
        (
            id: "observer",
            type: "observer::GoalObserver",
            config: {
                "goal": [
                    {"revolute": 0.4}, {"revolute": -0.3}, {"revolute": 0.5},
                    {"revolute": 0.0}, {"revolute": 0.4}, {"revolute": 0.0},
                ],
                "tolerance": 0.02,
                "max_cycles": 3000,
            },
        ),
    ],
    bridges: [
        (
            id: "mujoco",
            type: "repose_mujoco_sim::CuMujocoSimBridge",
            config: {"host": "127.0.0.1", "port": 55091, "read_timeout": 0.25},
            channels: [
                Tx(id: "joint_command", msg: "repose_controller::CuJointCommandPayload<6>"),
                Rx(id: "joint_state", msg: "repose_kinematics::CuJointStatePayload<6>"),
            ],
        ),
    ],
    cnx: [
        (src: "mujoco/joint_state", dst: "goal", msg: "repose_kinematics::CuJointStatePayload<6>"),
        (src: "goal", dst: "planner", msg: "repose_motion_planning::CuJointPlanRequest<6>"),
        (src: "planner", dst: "timing", msg: "repose_motion_planning::CuJointPlanPath<6>"),
        (src: "timing", dst: "follower", msg: "repose_trajectory::CuTrajectoryPayload<6, 1024>"),
        (src: "follower", dst: "controller", msg: "repose_trajectory::CuTrajectoryFollowOutput<6>"),
        (src: "mujoco/joint_state", dst: "controller", msg: "repose_kinematics::CuJointStatePayload<6>"),
        (src: "controller", dst: "mujoco/joint_command", msg: "repose_controller::CuJointCommandPayload<6>"),
        (src: "mujoco/joint_state", dst: "observer", msg: "repose_kinematics::CuJointStatePayload<6>"),
        (src: "controller", dst: "observer", msg: "repose_controller::CuJointCommandPayload<6>"),
    ],
)
